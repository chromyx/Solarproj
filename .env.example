# NON-SECRET SAMPLE VALUES ONLY — this is documentation, not a live configuration.
POWERDESK_MODE=SIMULATION_ONLY
POWERDESK_MARKET_ZONE=AL
POWERDESK_TIMEZONE=Europe/Tirane
POWERDESK_CAPACITY_MW=15.5
POWERDESK_CAPACITY_BASIS=UNKNOWN_DC_OR_AC
POWERDESK_SITE_LATITUDE=
POWERDESK_SITE_LONGITUDE=
POWERDESK_GRID_EXPORT_LIMIT_MW=
# Set real data credentials only through approved secret management, never this file.
# Local development database (non-secret default matching docker-compose.yml):
POWERDESK_DATABASE_URL=postgresql+psycopg://powerdesk:powerdesk_dev@localhost:5432/powerdesk
# Separate database for tests (tests TRUNCATE its tables):
POWERDESK_TEST_DATABASE_URL=postgresql+psycopg://powerdesk:powerdesk_dev@localhost:5432/powerdesk_test
